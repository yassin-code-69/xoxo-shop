APP_NAME=XoXo Shop API
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:8000

# CORS - list every origin explicitly. Only set the regex for preview deployments,
# and keep it anchored (never a bare .*\.vercel\.app, that allows anyone's project).
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
# BACKEND_CORS_ORIGIN_REGEX=^https://xoxo-shop-[a-z0-9-]+\.vercel\.app$

# Hostnames this API answers to. Set real values in production, e.g.
# ALLOWED_HOSTS=["api.xoxoshop.com"]
ALLOWED_HOSTS=["*"]

# Reverse proxies in front of the app (Railway/Vercel/nginx = 1). 0 ignores
# X-Forwarded-For, which stops clients spoofing their IP past rate limits.
TRUSTED_PROXY_COUNT=0

# Database (PostgreSQL / Supabase or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./xoxo_shop.db

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# REQUIRED in production - the app refuses to start without it, because every
# access token is verified against this secret.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-custom-secret
ACCESS_TOKEN_EXPIRE_HOURS=24

# Dev-only token factory at POST /auth/mock-token. Must stay false anywhere real.
ENABLE_MOCK_AUTH=false

# Admin bootstrap. ADMIN_INITIAL_PASSWORD creates the FIRST admin account only;
# it never resets an existing one. Leave empty after the account exists.
ADMIN_EMAIL=admin@xoxoshop.com
ADMIN_INITIAL_PASSWORD=

# Diamond Provider
PROVIDER_NAME=mock
PROVIDER_API_BASE_URL=https://api.mockprovider.com
PROVIDER_API_KEY=mock-key
MOCK_PROVIDER_OUTCOME=success

# Payment
MANUAL_PAYMENT_ENABLED=true
AUTOMATIC_PAYMENT_ENABLED=true

# bKash Gateway
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:8000/api/v1/payments/bkash/callback

# Nagad Gateway
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_CALLBACK_URL=http://localhost:8000/api/v1/payments/nagad/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000


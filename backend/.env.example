APP_NAME=XoXo Shop API
APP_ENV=development
DEBUG=true
APP_URL=http://localhost:8000

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database (PostgreSQL / Supabase or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./xoxo_shop.db

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-or-custom-secret

# Diamond Provider
PROVIDER_NAME=mock
PROVIDER_API_BASE_URL=https://api.mockprovider.com
PROVIDER_API_KEY=mock-key
MOCK_PROVIDER_OUTCOME=success

# Payment
MANUAL_PAYMENT_ENABLED=true
AUTOMATIC_PAYMENT_ENABLED=true

# bKash Gateway
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_CALLBACK_URL=http://localhost:8000/api/v1/payments/bkash/callback

# Nagad Gateway
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_CALLBACK_URL=http://localhost:8000/api/v1/payments/nagad/callback

# Frontend URL
FRONTEND_URL=http://localhost:3000

